--- !u!114 &633058987838
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 65319092136}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1f905dcc8b1041dcbad8df7378cd155e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CompanionInteraction
  animator: {fileID: 305678285398}
  dialogueUI: {fileID: 90660096}
  lines:
  - text: Uttini!
    sound: {fileID: 8300000, guid: ce2bc6e7658a87d4ea9c08e14a097ef0, type: 3}
  - text: That's our way to greet a stranger. It means arrive without harm. Or at
      least is what we hope, these lands have changed...
    sound: {fileID: 8300000, guid: 2a909d225a5afea41962f6d738bd4ce6, type: 3}
  - text: Ahead of you scary creatures will try yo harm you... But if you wish to
      continue I'd assume you have great mobility, even for such a little creature
    sound: {fileID: 8300000, guid: 2a909d225a5afea41962f6d738bd4ce6, type: 3}
  closingLine:
    text: See you ahead of the road... if your little body manages to get there
    sound: {fileID: 8300000, guid: 68d29638df800ad4c88e515a2ce38415, type: 3}
  sfxPlayer: {fileID: 378457128190}
